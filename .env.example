# Virtual paper bankroll. No broker, wallet, or live orders.
PAPER_BANKROLL=1000

# Slow sleeve: dual momentum on two ETFs, monthly.
SLOW_SYMBOLS=SPY,EZU
SLOW_SLEEVE_FRACTION=0.80

# Snap sleeve: short-hold QQQ washout, small size.
SNAP_SYMBOLS=QQQ
SNAP_SLEEVE_FRACTION=0.08
SNAP_RSI=2
SNAP_RSI_BUY=10
SNAP_SMA_FILTER=200
SNAP_SMA_EXIT=5
SNAP_MAX_DAYS=5
SNAP_ATR=20
SNAP_STOP_ATR=2.5
SNAP_RISK_FRACTION=0.0075
SLOW_LOOKBACK=252
SLOW_SKIP=21
SLOW_SMA=210

# Pulse sleeve: crypto 4h breakout, small size.
PULSE_SYMBOLS=BTCUSDT,ETHUSDT
PULSE_SLEEVE_FRACTION=0.12
PULSE_RISK_FRACTION=0.01
PULSE_DONCHIAN=20
PULSE_EXIT_CHANNEL=10
PULSE_ATR=14
PULSE_STOP_ATR=2.5
PULSE_TRAIL_ATR=3.0

DAILY_LOSS_HALT=0.05
POLL_INTERVAL_SECONDS=30
ETF_REFRESH_SECONDS=3600
CRYPTO_BAR_SECONDS=60

SLOW_FEE_BPS=5
SLOW_SLIP_BPS=2
PULSE_FEE_BPS=10
PULSE_SLIP_BPS=5
MIN_TRADE_NOTIONAL=15

DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/market_bot
REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002/ws

# Empty on the Mac. On the VPS, set a long random token (same value as DESK_TOKEN).
DESK_TOKEN=

# Grok desk review on /analysis. Server-side only. Never put this in the browser.
XAI_API_KEY=

# On a VPS, replace localhost with the server IP or hostname
# (the browser runs on your laptop, so it cannot use "localhost" for the API).
# Example:
# CORS_ORIGINS=http://YOUR_VPS_IP:3001
# NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8002
# NEXT_PUBLIC_WS_URL=ws://YOUR_VPS_IP:8002/ws
